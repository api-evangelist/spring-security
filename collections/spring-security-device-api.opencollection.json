{
  "opencollection": "1.0.0",
  "info": {
    "name": "Spring Server Authorization Device API",
    "version": "1.3.0"
  },
  "items": [
    {
      "info": {
        "name": "Device",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Device Authorization Request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:9000/oauth2/device_authorization",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "scope",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Initiates the OAuth 2.0 Device Authorization Grant per RFC 8628"
        }
      ]
    }
  ],
  "bundled": true
}