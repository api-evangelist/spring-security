{
  "opencollection": "1.0.0",
  "info": {
    "name": "Spring Authorization Server API",
    "version": "1.3.0"
  },
  "items": [
    {
      "info": {
        "name": "Authorization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OAuth2 Authorization Request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:9000/oauth2/authorize",
            "params": [
              {
                "name": "response_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "client_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "redirect_uri",
                "value": "",
                "type": "query"
              },
              {
                "name": "scope",
                "value": "",
                "type": "query"
              },
              {
                "name": "state",
                "value": "",
                "type": "query"
              },
              {
                "name": "code_challenge",
                "value": "",
                "type": "query"
              },
              {
                "name": "code_challenge_method",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Initiates the OAuth 2.1 authorization code flow with PKCE"
        }
      ]
    },
    {
      "info": {
        "name": "Token",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OAuth2 Token Request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:9000/oauth2/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "code",
                  "value": ""
                },
                {
                  "name": "redirect_uri",
                  "value": ""
                },
                {
                  "name": "code_verifier",
                  "value": ""
                },
                {
                  "name": "refresh_token",
                  "value": ""
                },
                {
                  "name": "scope",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Issues access tokens for all supported grant types"
        },
        {
          "info": {
            "name": "Token Introspection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:9000/oauth2/introspect",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "token",
                  "value": ""
                },
                {
                  "name": "token_type_hint",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Validates tokens and returns active token metadata per RFC 7662"
        },
        {
          "info": {
            "name": "Token Revocation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:9000/oauth2/revoke",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "token",
                  "value": ""
                },
                {
                  "name": "token_type_hint",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Revokes access or refresh tokens per RFC 7009"
        }
      ]
    },
    {
      "info": {
        "name": "Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JSON Web Key Set",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:9000/oauth2/jwks"
          },
          "docs": "Returns public signing keys for JWT verification"
        }
      ]
    },
    {
      "info": {
        "name": "Device",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Device Authorization Request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:9000/oauth2/device_authorization",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "scope",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Initiates the OAuth 2.0 Device Authorization Grant per RFC 8628"
        }
      ]
    },
    {
      "info": {
        "name": "Client Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Dynamic Client Registration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:9000/connect/register",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Registers a new OAuth2 client dynamically per RFC 7591"
        }
      ]
    },
    {
      "info": {
        "name": "OpenID Connect",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OpenID Connect UserInfo",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:9000/userinfo",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns claims about the authenticated end-user"
        },
        {
          "info": {
            "name": "OpenID Connect Session Logout",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:9000/connect/logout",
            "params": [
              {
                "name": "id_token_hint",
                "value": "",
                "type": "query"
              },
              {
                "name": "post_logout_redirect_uri",
                "value": "",
                "type": "query"
              },
              {
                "name": "state",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Initiates OIDC RP-initiated logout"
        }
      ]
    },
    {
      "info": {
        "name": "Discovery",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OpenID Connect Discovery",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:9000/.well-known/openid-configuration"
          },
          "docs": "Returns authorization server OIDC metadata"
        },
        {
          "info": {
            "name": "OAuth2 Server Metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:9000/.well-known/oauth-authorization-server"
          },
          "docs": "Returns RFC 8414 authorization server metadata"
        }
      ]
    }
  ],
  "bundled": true
}