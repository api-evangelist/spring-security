{
  "opencollection": "1.0.0",
  "info": {
    "name": "Spring Server Authorization OpenID Connect API",
    "version": "1.3.0"
  },
  "items": [
    {
      "info": {
        "name": "OpenID Connect",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OpenID Connect UserInfo",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:9000/userinfo",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns claims about the authenticated end-user"
        },
        {
          "info": {
            "name": "OpenID Connect UserInfo Endpoint (POST)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:9000/userinfo",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns claims about the authenticated end-user via POST method"
        },
        {
          "info": {
            "name": "OpenID Connect Session Logout",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:9000/connect/logout",
            "params": [
              {
                "name": "id_token_hint",
                "value": "",
                "type": "query"
              },
              {
                "name": "post_logout_redirect_uri",
                "value": "",
                "type": "query"
              },
              {
                "name": "state",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Initiates OIDC RP-initiated logout"
        }
      ]
    }
  ],
  "bundled": true
}