{
  "opencollection": "1.0.0",
  "info": {
    "name": "Spring Server Authorization Token API",
    "version": "1.3.0"
  },
  "items": [
    {
      "info": {
        "name": "Token",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OAuth2 Token Request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:9000/oauth2/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "code",
                  "value": ""
                },
                {
                  "name": "redirect_uri",
                  "value": ""
                },
                {
                  "name": "code_verifier",
                  "value": ""
                },
                {
                  "name": "refresh_token",
                  "value": ""
                },
                {
                  "name": "scope",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Issues access tokens for all supported grant types"
        },
        {
          "info": {
            "name": "Token Introspection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:9000/oauth2/introspect",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "token",
                  "value": ""
                },
                {
                  "name": "token_type_hint",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Validates tokens and returns active token metadata per RFC 7662"
        },
        {
          "info": {
            "name": "Token Revocation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:9000/oauth2/revoke",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "token",
                  "value": ""
                },
                {
                  "name": "token_type_hint",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Revokes access or refresh tokens per RFC 7009"
        }
      ]
    }
  ],
  "bundled": true
}